# 项目数据、结果和原始代码均纳入版本控制；临时产物继续忽略。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/项目文件校验.csv
!/组员说明.txt
!/*.doc
!/*.docx
!/代码/
/代码/*
!/代码/*.py
!/原始代码/
!/原始数据/
!/输入数据/
!/运行结果/
!/docs/
/docs/*
!/docs/*.md
!/tools/
/tools/*
!/tools/check_public_files.py
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push
!/.githooks/post-checkout
!/.githooks/post-commit
!/.githooks/post-merge
!/data/
/data/*
!/data/annual_reports/
/data/annual_reports/*
!/data/annual_reports/README.md
!/data/annual_reports/annual_report_index.csv
.env
.env.*
*.pem
*.key
__pycache__/
*.pyc
